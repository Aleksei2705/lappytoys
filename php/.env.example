APP_ENV=production
APP_URL=https://lappytoys.kz

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=""

CALENDLY_URL=

TELEGRAM_BOT_TOKEN=
# Число, не @username: личка — id у @userinfobot; группа — отрицательное -100…
TELEGRAM_CHAT_ID=
# Ваш numeric user id в Telegram (для кнопок «Оплачено» в группе). Узнать: @userinfobot
TELEGRAM_ADMIN_USER_IDS=
# Необязательно: секрет webhook. Если пусто, его создаст кнопка в админке «Включить кнопки».
TELEGRAM_WEBHOOK_SECRET=

IP_HASH_SALT=

MAIL_FROM=noreply@lappytoys.kz

# OpenRouter: ключ с https://openrouter.ai/keys (начинается с sk-or-). В git не коммитить.
# Если ключ sk-or- или URL содержит openrouter.ai, чат идёт в OpenRouter, иначе в Gemini.
ASSISTANT_API_KEY=
ASSISTANT_API_URL=https://openrouter.ai/api/v1/chat/completions
ASSISTANT_MODEL=google/gemini-2.5-flash
